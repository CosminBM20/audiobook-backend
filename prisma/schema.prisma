generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String              @id @default(uuid())
  email            String              @unique
  passwordHash     String
  name             String
  role             Role                @default(USER)
  preferredVolume  Float               @default(0.7)
  createdAt        DateTime            @default(now())
  favorites             Favorite[]
  listeningHistory      ListeningProgress[]
  personalBooks         PersonalBook[]
  bookmarks             Bookmark[]
  listenLater           ListenLater[]
  personalBookProgress  PersonalBookProgress[]
  personalBookBookmarks PersonalBookBookmark[]
  challenges        UserChallenge[]
  streak            UserStreak?
  createdChallenges Challenge[]     @relation("ChallengeCreator")
}

enum Role {
  USER
  ADMIN
}

model Author {
  id         String      @id @default(uuid())
  name       String      @unique
  audiobooks Audiobook[]
}

model Category {
  id         String      @id @default(uuid())
  name       String      @unique
  audiobooks Audiobook[]
}

model Audiobook {
  id               String              @id @default(uuid())
  title            String
  description      String
  coverImageUrl    String?
  audioFileUrl     String
  durationSeconds  Int
  language         String              @default("ro")
  authorId         String
  categoryId       String
  createdAt        DateTime            @default(now())

  author           Author              @relation(fields: [authorId], references: [id])
  category         Category            @relation(fields: [categoryId], references: [id])
  favorites        Favorite[]
  listeningHistory ListeningProgress[]
  bookmarks        Bookmark[]
  listenLater      ListenLater[]
  chapters         Chapter[]
}

model Chapter {
  id              String    @id @default(uuid())
  audiobookId     String
  title           String
  order           Int
  audioFileUrl    String
  durationSeconds Int
  createdAt       DateTime  @default(now())

  audiobook       Audiobook @relation(fields: [audiobookId], references: [id], onDelete: Cascade)
}

model Favorite {
  id          String    @id @default(uuid())
  userId      String
  audiobookId String
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  audiobook   Audiobook @relation(fields: [audiobookId], references: [id], onDelete: Cascade)

  @@unique([userId, audiobookId])
}

model ListeningProgress {
  id              String    @id @default(uuid())
  userId          String
  audiobookId     String
  currentPosition Int
  isCompleted     Boolean   @default(false)
  lastListened    DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  audiobook       Audiobook @relation(fields: [audiobookId], references: [id], onDelete: Cascade)

  @@unique([userId, audiobookId])
  @@index([userId, lastListened])
}

model PersonalBook {
  id        String   @id @default(uuid())
  title     String
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  progress  PersonalBookProgress[]
  bookmarks PersonalBookBookmark[]
}

model Bookmark {
  id          String    @id @default(uuid())
  userId      String
  audiobookId String
  position    Int
  label       String    @default("")
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  audiobook   Audiobook @relation(fields: [audiobookId], references: [id], onDelete: Cascade)
}

model ListenLater {
  id          String    @id @default(uuid())
  userId      String
  audiobookId String
  addedAt     DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  audiobook   Audiobook @relation(fields: [audiobookId], references: [id], onDelete: Cascade)

  @@unique([userId, audiobookId])
}

model PersonalBookProgress {
  id             String    @id @default(uuid())
  userId         String
  personalBookId String
  charOffset     Int       @default(0)
  totalChars     Int       @default(0)
  isCompleted    Boolean   @default(false)
  lastPlayedAt   DateTime?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalBook PersonalBook @relation(fields: [personalBookId], references: [id], onDelete: Cascade)

  @@unique([userId, personalBookId])
}

model PersonalBookBookmark {
  id             String    @id @default(uuid())
  userId         String
  personalBookId String
  charOffset     Int
  label          String    @default("")
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalBook PersonalBook @relation(fields: [personalBookId], references: [id], onDelete: Cascade)
}

enum ChallengeType {
  LISTENING_TIME
  BOOKS_COMPLETED
  PDF_SESSIONS
  STREAK
  CATEGORY_EXPLORER
}

enum ChallengePeriod {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
}

enum ChallengeDifficulty {
  EASY
  MEDIUM
  HARD
  LEGENDARY
}

model Challenge {
  id             String              @id @default(cuid())
  title          String
  description    String
  titleEn        String              @default("")
  descriptionEn  String              @default("")
  type           ChallengeType
  difficulty     ChallengeDifficulty
  target         Float
  period         ChallengePeriod
  xpReward       Int                 @default(0)
  isActive       Boolean             @default(false)
  isArchived     Boolean             @default(false)
  startsAt       DateTime?
  endsAt         DateTime?
  badgeIcon      String              @default("🏆")
  categoryFilter String?
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  createdBy    User            @relation("ChallengeCreator", fields: [createdById], references: [id])
  userProgress UserChallenge[]
}

model UserChallenge {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  periodKey   String
  progress    Float     @default(0)
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id])

  @@unique([userId, challengeId, periodKey])
}

model UserStreak {
  id               String    @id @default(cuid())
  userId           String    @unique
  current          Int       @default(0)
  longest          Int       @default(0)
  lastActivity     DateTime?
  freezesAvailable Int       @default(1)

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
